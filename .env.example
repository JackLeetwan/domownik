# Copy to .env and adjust. Everything else lives in ./data
# Public address of the app (links in notifications, later)
DOMOWNIK_BASE_URL=https://pc.example-tailnet.ts.net
# true when served over HTTPS (tailscale serve / Caddy)
DOMOWNIK_HTTPS_ONLY=true
# Host port (bound to 127.0.0.1)
DOMOWNIK_PORT=8000
# Cloud profile only
# DOMOWNIK_DOMAIN=domownik.example.com
# Container user owning ./data (0 when Docker runs with userns-remap, e.g. on the PC)
DOMOWNIK_UID=1000
DOMOWNIK_GID=1000
# Push notifications (Web Push, no extra app) – each user enables them in Ustawienia
# DOMOWNIK_MORNING_HOUR=8
# DOMOWNIK_EVENING_HOUR=19
# Background jobs (digests, autopay). false on throwaway copies so they never push.
# DOMOWNIK_SCHEDULER=true
