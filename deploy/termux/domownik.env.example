# ~/domownik.env on the phone (outside git)
DOMOWNIK_DATA_DIR=/data/data/com.termux/files/home/domownik-data
DOMOWNIK_SCHEDULER=true
DOMOWNIK_HTTPS_ONLY=true
DOMOWNIK_BASE_URL=https://domownik.<tailnet>.ts.net
TZ=Europe/Warsaw
# fast cores only (pages ~2× faster on a big.LITTLE phone). Find them:
#   grep . /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_max_freq   → the CPUs with the highest value
DOMOWNIK_CPUS=4-7
# ✉️ emails from the kindergarten → 📥 Do rozpoznania (read-only IMAP, once a day); leave empty = off.
# Password: a Google "app password" (myaccount.google.com → Bezpieczeństwo → Hasła do aplikacji), never the
# account password. Test: domownik mail-check --dry-run
#DOMOWNIK_MAIL_USER=you@gmail.com
#DOMOWNIK_MAIL_PASSWORD=xxxx xxxx xxxx xxxx
#DOMOWNIK_MAIL_FROM=teacher@example.com
#DOMOWNIK_MAIL_CHECK_AT=18:30
