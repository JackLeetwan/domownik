# ~/domownik.env on the phone (outside git)
DOMOWNIK_DATA_DIR=/data/data/com.termux/files/home/domownik-data
DOMOWNIK_SCHEDULER=true
DOMOWNIK_HTTPS_ONLY=true
DOMOWNIK_BASE_URL=https://domownik.<tailnet>.ts.net
TZ=Europe/Warsaw
# fast cores only (pages ~2× faster on a big.LITTLE phone). Find them:
#   grep . /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_max_freq   → the CPUs with the highest value
DOMOWNIK_CPUS=4-7
